# /etc/systemd/system/opence-master.service: master.goath1.com's master
# server (opence-master, github.com/OpenCommunityEdition/opence-master-server),
# behind Caddy (Caddyfile). The upstream unit (its deploy/opence-master.service),
# with its settings in /etc/opence-master/env (master.env.example; root's
# alone: it holds the admin token).
#
# The state (master.db, master.key) is in /var/lib/opence-master (with
# DynamicUser, /var/lib/private/opence-master); the key is made at the first
# start, mode 0600, and its public half is in the journal:
#   journalctl -u opence-master | grep "public key"
[Unit]
Description=GOAT H1 master server (opence-master)
Documentation=https://github.com/OpenCommunityEdition/opence-master-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=opence-master
StateDirectoryMode=0700
WorkingDirectory=/var/lib/opence-master
Environment=MASTER_DB=/var/lib/opence-master/master.db
Environment=MASTER_KEY=/var/lib/opence-master/master.key
Environment=MASTER_LISTEN=127.0.0.1:8090
Environment=MASTER_TRUSTED_PROXIES=127.0.0.1,::1
EnvironmentFile=/etc/opence-master/env
ExecStartPre=/usr/local/bin/opence-master keygen --keep --out /var/lib/opence-master/master.key
ExecStart=/usr/local/bin/opence-master serve
Restart=always
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
