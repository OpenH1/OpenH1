# /etc/opence-master/env: master.goath1.com's master settings (every option
# is in opence-master's README). Root's alone, mode 0600: it holds the admin
# token, which never goes in the repository. setup-master.sh writes it with
# a new token when there is none.
MASTER_PUBLIC_URL=https://master.goath1.com
MASTER_NAME=GOAT H1 master
# the game's name in the pages', the bot's and the mails' text (OpenH1's
# fork; README.md). The footer links the source at the running version's tag.
MASTER_GAME_NAME=GOAT H1
# the admin pages' token (32 characters or more: openssl rand -hex 32)
MASTER_ADMIN_TOKEN=<made on the server>
# No Discord bot: operators send their key and proof, and are approved on
# the admin pages or the command line (README.md, "The master server")
# Releases (the fork's): the admin pages say when one is out; we install it
# by hand with install-master.sh, which checks its signature (README.md)
MASTER_UPDATES=notify
# the netlist, which dedicated servers' server.vpn_policy checks players
# against
MASTER_NETLIST=on
