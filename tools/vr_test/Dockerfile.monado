# halo-xrtest-monado: a simulated headset for the VR build, with no display.
# Monado's null compositor, patched (monado-null-compositor.patch) so its
# refresh rate and eye size are settable (XRT_COMPOSITOR_NULL_FPS,
# XRT_COMPOSITOR_NULL_VIEW_SIZE; stock: 20 Hz, 128 pixels). Refer to README.md.
FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build pkg-config git ca-certificates \
    glslang-tools libvulkan-dev libeigen3-dev libx11-dev libx11-xcb-dev libxcb-randr0-dev libxrandr-dev libxcb1-dev \
    libwayland-dev wayland-protocols libudev-dev libusb-1.0-0-dev libhidapi-dev libbsd-dev \
    libcjson-dev libsystemd-dev libdbus-1-dev python3 libxxf86vm-dev libsdl2-dev
ARG MONADO_COMMIT=e26a272c1
RUN git clone https://gitlab.freedesktop.org/monado/monado.git /src && git -C /src checkout $MONADO_COMMIT
COPY monado-null-compositor.patch /tmp/
RUN git -C /src apply /tmp/monado-null-compositor.patch \
 && cmake -S /src -B /build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DXRT_HAVE_SDL2=OFF -DBUILD_TESTING=OFF -DXRT_BUILD_DRIVER_SIMULATED=ON \
 && ninja -C /build && ninja -C /build install

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends xvfb xauth mesa-utils libgl1-mesa-dri libglx-mesa0 \
    libegl1 libegl-mesa0 mesa-vulkan-drivers vulkan-tools libvulkan1 libopenxr-loader1 libopenxr-utils \
    libx11-6 libxext6 libxrandr2 libxcursor1 libxi6 libxinerama1 libxxf86vm1 libxss1 libxfixes3 \
    libwayland-client0 libwayland-egl1 libxkbcommon0 libdecor-0-0 libdbus-1-3 libudev1 zlib1g ca-certificates file \
    monado-service libopenxr1-monado \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local /usr/local
# (Ubuntu's Monado for its libraries; the patched one in /usr/local is what runs)
RUN ldconfig
COPY container_run.sh /usr/local/bin/halo-vr-run
