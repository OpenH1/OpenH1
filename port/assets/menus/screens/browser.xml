<?xml version="1.0" encoding="UTF-8"?>
<!-- The server browser (docs/menu_screens.md): the public games on the
Internet, OpenH1's and Legacy ones, as the main menu's MULTIPLAYER opens it
(Campaign's CO-OP: on its CO-OP tab). It takes the place of Join Game's
screen while it is the server browser's; the games, their order, the
filters, the searches, the favorites and joining are menu_functions.c's
(the row source browser.games and the browser.* bindings and actions). The
tall layout: the title in the band (the counts at its right, HOST & MORE
in it), the tabs, the games' table with its columns' titles (a click sorts;
SERVER and MAP each a search), the chosen game's details in the panel
beside it, and the bar of prompts at the foot. On a touchscreen, its chips,
rows of two lines, one search at the top and the footer's buttons. -->
<screen name="browser" back="browser back">
	<header title="{browser.title}" detail="{browser.counts}">
		<button key="view" label="{browser.host}" if="browser.server" do="browser host"/>
	</header>
	<search value="browser.search.any" label="SEARCH" if="browser.filtered" when="touch"/>
	<tabs current="browser.tab" if="browser.filtered">
		<tab id="all" label="ALL" do="browser tab all"/>
		<tab id="dedicated" label="DEDICATED" do="browser tab dedicated"/>
		<tab id="openh1" label="OPENH1" do="browser tab openh1"/>
		<tab id="legacy" label="LEGACY" do="browser tab legacy"/>
		<tab id="coop" label="CO-OP" do="browser tab coop"/>
		<tab id="favorites" label="FAVORITES" do="browser tab favorites"/>
	</tabs>
	<table source="browser.games" sorted="browser.sort" do="browser join" empty="{browser.empty}">
		<column id="favorite" kind="star" width="16" do="browser favorite" touch="10 18 16 0 0"/>
		<column id="server" label="SERVER" kind="strong" width="110" grow="64" title-width="76" sort="browser sort server" touch="32 7 220 0 144">
			<search value="browser.search.server" if="browser.filtered"/>
		</column>
		<column id="map" label="MAP" width="78" grow="44" sort="browser sort map" touch="32 30 120 0 72">
			<search value="browser.search.map" if="browser.filtered"/>
		</column>
		<column id="mode" label="MODE" width="60" grow="36" sort="browser sort mode" touch="158 30 100 72 72"/>
		<column id="players" label="PLAYERS" width="56" gap="2" align="right" sort="browser sort players" touch="272 7 80 144 0"/>
		<column id="ping" label="PING" kind="ping" width="54" align="right" sort="browser sort ping" touch="272 30 80 144 0"/>
		<button key="accept" label="CLEAR SEARCH" if="browser.searched" do="search clear"/>
	</table>
	<panel>
		<heading text="{browser.panel.title}" lines="2"/>
		<text text="{browser.panel.where}" lines="2"/>
		<pills>
			<pill text="{browser.panel.kind}" tone="browser.panel.kind.tone" width="64"/>
			<pill text="{browser.panel.tick}" tone="2" width="64"/>
			<pill text="{browser.panel.opence}" tone="2" width="132"/>
		</pills>
		<pair label="PLAYERS" value="{browser.panel.players}" when="pointer"/>
		<pair label="PING" value="{browser.panel.ping}" when="pointer"/>
		<text text="{browser.panel.status}" lines="3" touch-lines="4"/>
		<button key="accept" label="JOIN GAME" if="browser.joinable" do="browser join"/>
	</panel>
	<buttons>
		<button key="y" label="FAVORITE" width="108" do="browser favorite"/>
		<button key="rt" label="REFRESH" width="102" if="browser.server" do="browser refresh"/>
		<button key="rt" label="PASTE LINK" width="124" if="browser.link" do="browser refresh"/>
		<button key="r3" label="SEARCH" width="97" if="browser.filtered" do="search next" when="pointer"/>
		<button key="x" label="SORT" width="90" do="browser sort next" when="pointer"/>
		<button key="x" label="SORT: {browser.sort.title}" do="browser sort next" when="touch"/>
		<button key="lt" label="FILTERS" width="97" if="browser.filtered" do="browser filters" when="pointer"/>
		<button key="back" label="BACK" width="88" do="browser back"/>
	</buttons>
</screen>
