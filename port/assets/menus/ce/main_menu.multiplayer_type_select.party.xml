	<widget name="main_menu/multiplayer_type_select/party/party_button_copy" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" text="COPY LINK" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
