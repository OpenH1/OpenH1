	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/weapon_position/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="Moves your weapon and hands right, or left below 0, in centimeters, for every weapon, as far on the screen at any weapon field of view. 0 keeps them where the game puts them. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Moves your weapon and hands up, or down below 0, in centimeters. Lower it to see more of the screen. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Pushes your weapon and hands away from you, or closer below 0, in centimeters. Too close and they cut off. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Tilts your weapon's muzzle up, or down below 0, in degrees, turning it in place. Your shots still go where the reticle points. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -15 to 15."/>
		<string text="Turns your weapon's muzzle right, or left below 0, in degrees. Your shots still go where the reticle points. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -15 to 15."/>
		<string text="Tilts the top of your weapon right, or left below 0, in degrees. Your shots still go where the reticle points. In a game, Settings from the pause menu also sets the weapon you hold on its own.|Click the number (or press A) to type any from -15 to 15."/>
		<string text=""/>
		<string text="Moves the weapon you hold right, or left below 0, in centimeters, added to All Weapons'. Each weapon keeps its own, a modded map's too.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Moves the weapon you hold up, or down below 0, in centimeters, added to All Weapons'.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Pushes the weapon you hold away, or closer below 0, in centimeters, added to All Weapons'.|Click the number (or press A) to type any from -20 to 20."/>
		<string text="Tilts the muzzle of the weapon you hold up, or down below 0, in degrees, added to All Weapons'.|Click the number (or press A) to type any from -15 to 15."/>
		<string text="Turns the muzzle of the weapon you hold right, or left below 0, in degrees, added to All Weapons'.|Click the number (or press A) to type any from -15 to 15."/>
		<string text="Tilts the top of the weapon you hold right, or left below 0, in degrees, added to All Weapons'.|Click the number (or press A) to type any from -15 to 15."/>
		<string text="Puts the weapon you hold back to All Weapons' place: its own offsets go back to 0 when you press OK."/>
	</strings>
