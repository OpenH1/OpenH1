	</look>
	<look name="main_menu/difficulty_select/difficulty_select_list" type="column_list">
		<at widget="main_menu/difficulty_select/kindergarten_difficulty_item" x="0" y="0"/>
		<at widget="main_menu/difficulty_select/normal_difficulty_item" x="0" y="0"/>
