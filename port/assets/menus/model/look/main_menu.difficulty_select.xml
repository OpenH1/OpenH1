<?xml version="1.0" encoding="UTF-8"?>
<!-- The look of ce/main_menu.difficulty_select.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_look.py) -->
<model>
	<look name="main_menu/difficulty_select/difficulty_ext_desc" box="275 78 595 400" picture="bitmaps/list_field">
		<text color="#FF0080FF"/>
		<at widget="main_menu/difficulty_select/difficulty_options" x="333" y="88"/>
		<at widget="main_menu/difficulty_select/difficulty_extended_description" x="0" y="0"/>
		<at widget="main_menu/current_profile_name" x="0" y="0"/>
	</look>
	<look name="main_menu/difficulty_select/difficulty_extended_description" type="text" box="275 78 580 400">
		<text font="ui\large_ui" color="#FF2896FF" at="12 220" string_list="main_menu/difficulty_select/difficulty_descriptions"/>
	</look>
	<look name="main_menu/difficulty_select/difficulty_options" box="0 0 200 211" picture="ui\shell\main_menu\difficulty_select\difficulty_options"/>
	<look name="main_menu/difficulty_select/difficulty_select_button_bar" type="column_list" box="0 0 640 28">
