<?xml version="1.0" encoding="UTF-8"?>
<!-- The look of ce/error.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_look.py) -->
<model>
	<look name="error/confirm_delete_gametype" picture="bitmaps/semi_transparent_grey">
		<at widget="error/confirm_delete_gametype_text_box" x="192" y="176"/>
		<at widget="error/header_warning" x="201" y="180"/>
	</look>
	<look name="error/confirm_delete_gametype_button_bar" type="column_list" box="0 0 256 20">
		<at widget="error/confirm_delete_gametype_button_cancel" x="128" y="0"/>
		<at widget="error/confirm_delete_gametype_button_ok" x="0" y="0"/>
	</look>
	<look name="error/confirm_delete_gametype_button_cancel" type="text" box="0 0 128 24" picture="bitmaps/text_button_background">
		<text font="ui\small_ui" color="#FFFFFFFF" align="center" at="0 2" string_list="strings/common_button_captions" index="2"/>
	</look>
	<look name="error/confirm_delete_gametype_button_ok" type="text" box="0 0 128 24" picture="bitmaps/text_button_background">
		<text font="ui\small_ui" color="#FFFFFFFF" align="center" at="0 2" string_list="strings/common_button_captions" index="1"/>
	</look>
	<look name="error/confirm_delete_gametype_modal_fullscreen">
		<at widget="error/confirm_delete_gametype" x="0" y="0"/>
		<at widget="error/confirm_delete_gametype_button_bar" x="194" y="309"/>
	</look>
	<look name="error/confirm_delete_gametype_text_box" type="text" box="0 0 280 159" picture="bitmaps/alert_bkd">
		<text font="ui\large_ui" color="#FF2896FF" at="9 36" string_list="strings/displayed_error_messages" index="25"/>
	</look>
	<look name="error/confirm_delete_profile" picture="bitmaps/semi_transparent_grey">
