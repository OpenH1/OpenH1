<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.solo_level_select.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/solo_level_select/solo_level_select_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/solo_level_select/solo_level_select_button_ok">
		<on event="a" run="emit custom activation event"/>
		<on event="start" run="emit custom activation event"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/solo_level_select/solo_level_select_list" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="initialize sp level list solo"/>
		<on event="deleted" run="dispose sp level list"/>
		<on event="custom_activation" run="solo level set map" open="main_menu/difficulty_select/difficulty_select_list_screen"/>
	</behaviour>
	<behaviour name="main_menu/solo_level_select/solo_level_select_screen" flags="pass_unhandled_to_focused_child"/>
</model>
