<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/shell.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="common_button_back">
		<on event="a" run="mouse emit back event"/>
		<on event="start" run="mouse emit back event"/>
		<on event="left_mouse" run="mouse emit back event"/>
	</behaviour>
	<behaviour name="common_button_cancel">
		<on event="a" run="mouse emit back event"/>
		<on event="start" run="mouse emit back event"/>
		<on event="left_mouse" run="mouse emit back event"/>
	</behaviour>
</model>
