	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/ctf_edit/ctf_button_ok">
		<on event="a" run="mp profile set ctf rules" back="true"/>
		<on event="start" run="mp profile set ctf rules" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/ctf_edit/ctf_options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="mp profile init ctf rules"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/ctf_edit/ctf_options_screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="NULL"/>
	</behaviour>
