		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/ctf_edit/op_assault" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/ctf_edit/op_captures_to_win" flags="pass_unhandled_to_focused_child"/>
