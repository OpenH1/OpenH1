<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.profile_manager.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/profile_manager/multiplayer_creating_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="deleted" run="new campaign decision" open="main_menu/profile_manager/multiplayer_saving_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/multiplayer_saving_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="b" run="NULL"/>
		<on event="back" run="NULL"/>
		<on event="deleted" run="NULL" open="main_menu/multiplayer_type_select/multiplayer_type_select_screen"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/player_profile_manager" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/profile_manager/player_profile_manager_screen" flags="pass_unhandled_to_focused_child">
		<on event="x" run="request del player profile" open="error/confirm_delete_profile_modal_fullscreen"/>
		<on event="y" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/pm_empty_creating_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="deleted" run="new campaign decision" open="main_menu/profile_manager/pm_empty_saving_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/pm_empty_saving_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="b" run="NULL"/>
		<on event="back" run="NULL"/>
		<on event="deleted" run="NULL"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/pm_empty_selected" flags="pass_unhandled_to_focused_child no_history">
		<on event="a" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
		<on event="start" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/pm_empty_selected_button_bar" flags="pass_unhandled_to_focused_child up_down_tabs_items left_right_tabs_items"/>
	<behaviour name="main_menu/profile_manager/pm_empty_selected_button_ok">
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/profile_manager_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/profile_manager/profile_manager_button_delete">
		<on event="a" run="mouse emit x event"/>
		<on event="start" run="mouse emit x event"/>
		<on event="left_mouse" run="mouse emit x event"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/profile_manager_button_new">
		<on event="a" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
		<on event="start" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
		<on event="left_mouse" run="new campaign chosen" open="main_menu/profile_manager/pm_empty_creating_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/profile_manager_button_ok">
		<on event="a" run="emit custom activation event"/>
		<on event="start" run="emit custom activation event"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/profile_manager_select_list_2" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="player profile list initialize"/>
		<on event="deleted" run="player profile list dispose"/>
		<on event="custom_activation" run="profile manager select" back="true" branch="true"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/settings_creating_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="deleted" run="new campaign decision" open="main_menu/profile_manager/settings_saving_profile"/>
	</behaviour>
	<behaviour name="main_menu/profile_manager/settings_saving_profile" flags="pass_unhandled_to_focused_child no_history">
		<on event="b" run="NULL"/>
		<on event="back" run="NULL"/>
		<on event="deleted" run="NULL" open="main_menu/settings_select/player_setup/player_profile_edit/player_profile_edit_screen"/>
	</behaviour>
</model>
