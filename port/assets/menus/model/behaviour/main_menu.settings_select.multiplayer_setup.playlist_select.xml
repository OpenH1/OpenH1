<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.multiplayer_setup.playlist_select.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/gametype_select_screen" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/playlist_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/playlist_button_delete">
		<on event="a" run="mouse emit x event"/>
		<on event="start" run="mouse emit x event"/>
		<on event="left_mouse" run="mouse emit x event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/playlist_button_new">
		<on event="a" run="create&amp;edit playlist profile" open="main_menu/settings_select/multiplayer_setup/create_and_edit_new_gametype_screen"/>
		<on event="start" run="create&amp;edit playlist profile" open="main_menu/settings_select/multiplayer_setup/create_and_edit_new_gametype_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/playlist_button_ok">
		<on event="a" run="emit custom activation event"/>
		<on event="start" run="emit custom activation event"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_select/playlist_select_list" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="mp profiles list initialize"/>
		<on event="deleted" run="mp profiles list dispose"/>
		<on event="custom_activation" run="mp profile begin editing" open="main_menu/settings_select/multiplayer_setup/playlist_edit/gametype_edit_screen"/>
		<on event="x" run="request del playlist profile" open="error/confirm_delete_gametype_modal_fullscreen"/>
	</behaviour>
</model>
