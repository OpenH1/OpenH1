<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.doubles.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/main_menu_item_doubles">
		<on event="a" open="main_menu/doubles/doubles_screen"/>
		<on event="start" open="main_menu/doubles/doubles_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/doubles/doubles_screen" flags="pass_unhandled_to_focused_child">
		<on event="b" back="true"/>
		<on event="back" back="true"/>
		<on event="x" run="port matchmaking x"/>
	</behaviour>
	<behaviour name="main_menu/doubles/doubles_list" flags="pass_unhandled_to_focused_child up_down_tabs_items"/>
	<behaviour name="main_menu/doubles/mm_row_0">
		<on event="a" run="port matchmaking button"/>
		<on event="start" run="port matchmaking button"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/doubles/mm_row_1">
		<on event="a" run="port matchmaking button"/>
