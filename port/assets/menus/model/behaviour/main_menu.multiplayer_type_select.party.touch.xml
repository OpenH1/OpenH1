		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/party/touch/prompt_back">
		<on event="a" run="port party button"/>
		<on event="start" run="port party button"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
</model>
