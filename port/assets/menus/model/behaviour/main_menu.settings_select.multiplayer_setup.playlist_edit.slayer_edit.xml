	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/slayer_options_screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="NULL"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/team_play_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
