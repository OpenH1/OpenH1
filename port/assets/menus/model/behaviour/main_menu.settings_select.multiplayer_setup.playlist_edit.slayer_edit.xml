		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/kill_in_order_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/kill_penalty_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/kills_to_win_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/op_death_bonus" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/slayer_edit/op_kill_in_order" flags="pass_unhandled_to_focused_child"/>
