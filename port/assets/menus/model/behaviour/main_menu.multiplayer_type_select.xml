<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.multiplayer_type_select.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_create_internet_item">
		<on event="a" run="join controller to mp game"/>
		<on event="a" run="mp type set mode" open="main_menu/multiplayer_type_select/connected/connected_map_select_wrapper"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_create_lan_item">
		<on event="a" run="join controller to mp game"/>
		<on event="a" run="mp type set mode" open="main_menu/multiplayer_type_select/connected/connected_map_select_wrapper"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_gametypes_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/playlist_select/gametype_select_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/playlist_select/gametype_select_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_join_direct_item">
		<on event="a" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="start" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_join_internet_item">
		<on event="a" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="start" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_join_lan_item">
		<on event="a" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="start" run="mp type set mode" open="main_menu/multiplayer_type_select/join_game/join_game_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_select_list" flags="pass_unhandled_to_focused_child up_down_tabs_items"/>
	<behaviour name="main_menu/multiplayer_type_select/multiplayer_type_select_screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="mp type menu initialize"/>
		<on event="deleted" run="port multiplayer status end"/>
		<on event="right_trigger" run="port multiplayer refresh"/>
	</behaviour>
</model>
