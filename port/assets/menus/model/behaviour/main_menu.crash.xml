<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.crash.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/crash/crash_screen" flags="pass_unhandled_to_focused_child">
		<on event="b" run="port crash dismiss" back="true"/>
		<on event="back" run="port crash dismiss" back="true"/>
	</behaviour>
	<behaviour name="main_menu/crash/button_bar" flags="pass_unhandled_to_focused_child up_down_tabs_items left_right_tabs_items"/>
	<behaviour name="main_menu/crash/button_report">
		<on event="a" run="port crash report" back="true"/>
		<on event="start" run="port crash report" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/crash/button_skip">
		<on event="a" run="port crash dismiss" back="true"/>
		<on event="start" run="port crash dismiss" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
</model>
