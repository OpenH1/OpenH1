<!-- The behaviour of ce/main_menu.settings_select.multiplayer_setup.playlist_edit.race_edit.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/laps_to_win_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/op_laps_to_win" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/op_race_type" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/op_team_play" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/op_team_scoring" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/race_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/race_edit/race_button_ok">
		<on event="a" run="mp profile set racing rules" back="true"/>
		<on event="start" run="mp profile set racing rules" back="true"/>
