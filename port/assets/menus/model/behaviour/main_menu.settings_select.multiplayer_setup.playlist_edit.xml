<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.multiplayer_setup.playlist_edit.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/edit_playlist_select_list" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/gametype_edit_screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="close if not editing profile"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_button_ok">
		<on event="a" run="mp profile save changes" open="error/warning_saving_file_screen"/>
		<on event="start" run="mp profile save changes" open="error/warning_saving_file_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_game_type_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/playlist_edit/game_type_select/gametype_select_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/playlist_edit/game_type_select/gametype_select_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_indicators_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_items_list_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/item_options_edit/item_options_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/item_options_edit/item_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_name_list_item">
		<on event="a" run="mp profile change name" open="main_menu/settings_select/multiplayer_setup/name_edit/gametype_name_screen"/>
		<on event="start" run="mp profile change name" open="main_menu/settings_select/multiplayer_setup/name_edit/gametype_name_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_player_opts_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/player_options_edit/player_options_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/player_options_edit/player_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_team_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/teamplay_options_edit/teamplay_options_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/teamplay_options_edit/teamplay_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/playlist_edit_vehicles_list_item">
		<on event="a" open="main_menu/settings_select/multiplayer_setup/vehicle_options_edit/vehicle_options_screen"/>
		<on event="start" open="main_menu/settings_select/multiplayer_setup/vehicle_options_edit/vehicle_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
</model>
