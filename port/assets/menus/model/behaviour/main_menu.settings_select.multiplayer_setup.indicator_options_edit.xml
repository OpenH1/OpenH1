<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.multiplayer_setup.indicator_options_edit.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_button_ok">
		<on event="a" run="mp profile set indicator opts" back="true"/>
		<on event="start" run="mp profile set indicator opts" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_friends_on_screen_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="mp profile init indicator opts"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_players_on_radar_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_radar display_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/indicator_options_screen" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/op_friends_on_screen" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/op_players_on_radar" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/indicator_options_edit/op_radar display" flags="pass_unhandled_to_focused_child"/>
</model>
