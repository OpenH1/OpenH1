<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.quit_select.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/quit_select/quit_button_bar" flags="pass_unhandled_to_focused_child up_down_tabs_items left_right_tabs_items"/>
	<behaviour name="main_menu/quit_select/quit_button_ok">
		<on event="a" run="main menu quit game"/>
		<on event="start" run="main menu quit game"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/quit_select/quit_screen" flags="pass_unhandled_to_focused_child"/>
</model>
