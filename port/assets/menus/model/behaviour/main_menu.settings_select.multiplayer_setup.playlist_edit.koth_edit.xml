<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.multiplayer_setup.playlist_edit.koth_edit.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_button_ok">
		<on event="a" run="mp profile set koth rules" back="true"/>
		<on event="start" run="mp profile set koth rules" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_moving_hill_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="created" run="mp profile init koth rules"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_options_screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="NULL"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_score_to_win_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/koth_team_play_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="left_mouse" run="mouse spinner 1wide click"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/op_moving_hill" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/op_score_to_win" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/multiplayer_setup/playlist_edit/koth_edit/op_team_play" flags="pass_unhandled_to_focused_child"/>
</model>
