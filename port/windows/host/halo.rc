/* halo.exe's resources (tools/windows_build.py): its icon
(tools/app_icon.py), which Explorer and the taskbar show and SDL's windows
take, as the first icon of the executable; the manifest (halo.manifest:
24 is RT_MANIFEST, 1 a process's own); and its version information, whose
names Task Manager, the taskbar's tooltips and Open With show (the file
stays halo.exe) */
1 ICON "../openh1-icon.ico"
1 24 "halo.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "GOAT H1"
			VALUE "FileDescription", "GOAT H1"
			VALUE "ProductName", "GOAT H1"
			VALUE "InternalName", "halo"
			VALUE "OriginalFilename", "halo.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
