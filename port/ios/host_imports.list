# Host functions the iOS guest imports beyond the macOS guest's
# (port/linux/host/host_imports.list, port/macos/host_imports.list): the
# touch controls' (declared in port/android/guest/runtime/guest_host.h,
# defined in port/android/host/host_touch.c, which the iOS overlay,
# port/ios/touch_controls.m, hands its state to). tools/android_imports.py
# generates the stubs.
host_touch_read
host_touch_look_read
host_touch_rumble
host_touch_scene
host_touch_bindings
